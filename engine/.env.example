# Copy this file to engine/.env and fill in the key for whichever provider you use.
#   cp engine/.env.example engine/.env
#
# You only need the key matching the model selected in the app. The default
# model is gemini/gemini-2.5-flash-lite, so a GEMINI_API_KEY is enough to start.
# engine/.env is gitignored and never leaves your machine.

# Google Gemini (default model). Get one: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# OpenAI (GPT-4o). Get one: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Anthropic (Claude). Get one: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Local models via Ollama need no key. Uncomment to override the default address.
# OLLAMA_API_BASE=http://localhost:11434
